                "width": 2000,
                "height": 1500,
                "restart_when_active": false,
                "css": "/************************************************************\n  GLOBAL BACKGROUND + FONT\n*************************************************************/\n\nhtml,\nbody,\n#root,\n.chat-room,\n.chat-room__content,\n.scrollable-area,\n.tw-root--theme-dark {\n  background: transparent !important;\n  background-color: transparent !important;\n  font-family: 'JetBrains Mono', monospace !important;\n  color: #9cfff1 !important;\n  font-size: 100px !important;\n  line-height: 1.2 !important;\n}\n\n/************************************************************\n  REMOVE STREAM CHAT HEADER + ICON\n*************************************************************/\n\n.Layout-sc-1xcs6mc-0.jmERFg.stream-chat-header,\n.InjectLayout-sc-1i43xsx-0.iDMNUO {\n  display: none !important;\n}\n\n/************************************************************\n  REMOVE GIFT LEADERBOARD (ALL LAYERS)\n*************************************************************/\n\n.channel-leaderboard-header-rotating__users,\n.ScTransitionBase-sc-hx4quq-0.hhLPgp.tw-transition {\n  display: none !important;\n  height: 0 !important;\n  max-height: 0 !important;\n  overflow: hidden !important;\n}\n\n/************************************************************\n  REMOVE GIFT POPUPS\n*************************************************************/\n\n.Layout-sc-1xcs6mc-0.ikqKEy {\n  display: none !important;\n}\n\n/************************************************************\n  REMOVE ANIMATED EMOTE BANNER + CHAT INPUT BANNER\n*************************************************************/\n\n.Layout-sc-1xcs6mc-0.fysEov,\n.Layout-sc-1xcs6mc-0.bLZXTb,\n.Layout-sc-1xcs6mc-0.kklSOA.chat-input,\n.ScCoreButton-sc-ocjdkq-0.evvsZQ,\n.CoreText-sc-1txzju1-0.cWFBTs {\n  display: none !important;\n}\n\n/************************************************************\n  REMOVE COOKIES BANNER\n*************************************************************/\n\n[data-a-target=\"consent-banner\"],\n.consent-banner,\ndiv[class*=\"consent\"] {\n  display: none !important;\n}\n\n/************************************************************\n  REMOVE TWITCH PREDICTIONS BANNER COMPLETELY\n*************************************************************/\n\n.Layout-sc-1xcs6mc-0.cEllaX,\n.ScTransitionBase-sc-hx4quq-0.hhLPgp.tw-transition {\n  display: none !important;\n  visibility: hidden !important;\n  height: 0 !important;\n  max-height: 0 !important;\n  overflow: hidden !important;\n}\n\n/************************************************************\n  REMOVE USER BADGES\n*************************************************************/\n\n.chat-badge,\n.chat-badge-container,\nimg.chat-badge {\n  display: none !important;\n}\n\n/************************************************************\n  REMOVE FFZ REPLY LINE\n*************************************************************/\n\n.ffz--fix-reply-line,\n.chat-line__reply,\n[class*=\"reply\"] {\n  display: none !important;\n  visibility: hidden !important;\n  height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  font-size: 0 !important;\n  line-height: 0 !important;\n}\n\n/************************************************************\n  USERNAME (RED + SINGLE RED COLON)\n*************************************************************/\n\n.chat-author__display-name {\n  color: #46ffec !important;\n  font-weight: 500 !important;\n  font-size: 100px !important;\n}\n\n/* Remove Twitch default colon */\n.chat-line__message > span:not(.chat-author__display-name):first-child {\n  display: none !important;\n}\n\n/************************************************************\n  MESSAGE TEXT (WHITE)\n*************************************************************/\n\n.text-fragment {\n  color: #9cfff1 !important;\n  font-size: 100px !important;\n}\n\n/************************************************************\n  EMOTE SPACING FIX\n*************************************************************/\n\n.chat-image,\nimg.chat-line__message--emote {\n  margin: 0 4px !important;\n  vertical-align: middle !important;\n  max-height: 1em !important;\n}\n\nspan[class*=\"emote\"],\nspan[class*=\"emoji\"],\nspan[class*=\"chat-emote\"] {\n  display: inline !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.chat-line__message span {\n  letter-spacing: 0 !important;\n  word-spacing: 0 !important;\n}\n\n/************************************************************\n  TIMESTAMP\n*************************************************************/\n\n.chat-line__timestamp {\n  color: #9cfff1f !important;\n  opacity: 0.6;\n  margin-right: 10px;\n  font-size: 45px !important;\n}\n\n/************************************************************\n  SCROLLBAR\n*************************************************************/\n\n::-webkit-scrollbar {\n  display: none;\n}"
